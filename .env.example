# Copy this file to .env.local and fill it in. NEVER commit .env.local or paste the key anywhere public.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# AI chat: set ONE of these keys. Without any key the site uses the built-in keyword assistant.
# Option A (free tier): Groq key from console.groq.com (starts with gsk_)
GROQ_API_KEY=
# Option B (paid): Anthropic key from console.anthropic.com
ANTHROPIC_API_KEY=
# If both are set, Groq is used. Force one with: AI_PROVIDER=groq  or  AI_PROVIDER=claude

# Optional
# GROQ_MODEL=openai/gpt-oss-120b     # default; Groq retires models, see console.groq.com/docs/models
# CLAUDE_MODEL=claude-haiku-5-5      # default; small and cheap
# CHAT_IP_LIMIT=20                   # messages per visitor (IP) per 10 minutes
# CHAT_DAILY_LIMIT=300               # messages per day across all visitors

# Optional but recommended on Vercel: shared rate limiting (free Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
